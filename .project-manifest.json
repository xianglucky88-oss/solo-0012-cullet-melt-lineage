        "冻结原料及熔次事实"
      ]
    },
    {
      "id": "attribute",
      "name": "展开回炉物料来源",
      "entry": "python3 -B -m cullet --db demo.sqlite publish examples/batch.json",
      "success": "两层回炉仍保留各原料质量",
      "failure": "未知上游或环不得产出事实",
      "verification": "python3 -B examples/smoke.py",
      "module_ids": [
        "recipe",
        "balance",
        "releases",
        "__main__"
