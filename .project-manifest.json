      "steps": [
        "执行 publish examples/batch.json",
        "两层回炉仍保留各原料质量"
      ]
    },
    {
      "id": "compare",
      "name": "对照父版后的物料事实",
      "entry": "python3 -B -m cullet --db demo.sqlite read amber-trial bench-01",
      "success": "返回组成和发生变化的物料键",
      "failure": "未知发布版本时拒绝",
      "verification": "python3 -B examples/smoke.py",
      "module_ids": [
        "__main__",
        "releases",
        "recipe"
      ],
      "steps": [
        "执行 read amber-trial bench-01",
        "返回组成和发生变化的物料键"
      ]
    },
    {
      "id": "assay_publish",
      "name": "发布带成分化验的炉次",
      "entry": "python3 -B -m cullet --db demo.sqlite publish examples/assay.json",
      "success": "冻结逐实物成分上下界、支撑记录与放行状态",
      "failure": "样品越界、文档代替实测或缺合格依据时拒绝",
      "verification": "python3 -B examples/smoke_assay.py",
      "module_ids": [
        "recipe",
        "balance",
        "assay",
        "component",
        "releases",
        "__main__"
      ],
      "steps": [
        "执行 publish examples/assay.json",
        "冻结逐实物成分上下界、支撑记录与放行状态"
      ]
    },
    {
      "id": "assay_verdict",
      "name": "按所有相容解释签放行结论",
      "entry": "python3 -B -m cullet --db demo.sqlite read dust-trial day1",
      "success": "给出无条件合格、沿用条件或继续等待及可复核依据",
      "failure": "仍有超标风险或依赖未合格上游时拒绝签无条件合格",
      "verification": "python3 -B examples/smoke_assay.py",
      "module_ids": [
        "assay",
        "component",
        "releases",
        "__main__"
      ],
      "steps": [
        "执行 read dust-trial day1",
        "给出放行状态与依据"
      ]
    },
    {
      "id": "assay_retest",
      "name": "复验影响两炉时逐批说明可否共用",
      "entry": "python3 -B -m cullet --db demo.sqlite read dust-trial day2",
      "success": "逐支线给出上下界、支撑记录与复验前后状态",
      "failure": "删除或改写冻结证据、追认有条件投料时拒绝",
      "verification": "python3 -B examples/smoke_assay.py",
      "module_ids": [
        "assay",
        "component",
        "releases",
        "__main__"
      ],
      "steps": [
        "执行 read dust-trial day2",
        "逐支线给出上下界、支撑记录与复验前后状态"
      ]
    }
