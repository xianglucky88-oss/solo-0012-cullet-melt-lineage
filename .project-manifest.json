  "workflows": [
    {
      "id": "publish",
      "name": "发布首版物料图",
      "entry": "python3 -B -m cullet --db demo.sqlite publish examples/batch.json",
      "success": "冻结原料及熔次事实",
      "failure": "过量取料或投入产出不等时拒绝",
